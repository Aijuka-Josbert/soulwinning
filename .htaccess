# ============================================================
# Soul Winning Mission Church — Apache config
# Handles: caching, compression, security headers, hotlink
# protection. Requires mod_expires, mod_deflate, mod_headers,
# mod_rewrite (all standard/enabled on most Apache installs —
# see the deployment notes for how to check/enable them).
# ============================================================

# ---- 1. HTTPS enforcement (uncomment once SSL is confirmed working) ----
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 2. Browser caching ----
# Images/videos/fonts change rarely — cache them long. HTML/CSS/JS
# cache shorter so real fixes reach visitors without a hard refresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 30 days"
  ExpiresByType image/png         "access plus 30 days"
  ExpiresByType image/webp        "access plus 30 days"
  ExpiresByType image/svg+xml     "access plus 30 days"
  ExpiresByType video/mp4         "access plus 30 days"
  ExpiresByType text/css          "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

# ---- 3. Compression (shrinks HTML/CSS/JS in transit — does NOT
#     recompress already-compressed video/images, that would waste CPU) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json
</IfModule>

# ---- 4. Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Content-Security-Policy is deliberately loose here because the site
  # loads Font Awesome from cdnjs and embeds YouTube/Google Maps iframes.
  # Tighten the domain list further only if you stop using one of these.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; media-src 'self'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; script-src 'self'; frame-src https://www.youtube.com https://www.google.com https://maps.google.com; connect-src 'self' https://api.web3forms.com"
</IfModule>

# ---- 5. Hotlink protection for videos/images ----
# Stops other websites from embedding your video/image files directly
# and burning your bandwidth. Your own domain and empty referrers
# (direct visits, some browsers) are always allowed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?soulwinningmission\.org [NC]
  RewriteCond %{HTTP_REFERER} !^https?://localhost [NC]
  RewriteRule \.(mp4|jpg|jpeg|png|webp)$ - [F,L]
</IfModule>

# ---- 6. Don't expose raw directory listings ----
Options -Indexes

# ---- 7. Block access to this file and any stray config/text files ----
<FilesMatch "^(\.htaccess|\.env|.*\.log|.*\.bak)$">
  Require all denied
</FilesMatch>
